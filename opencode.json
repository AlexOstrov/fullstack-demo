{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/memory/STATE.md", "docs/memory/BACKLOG.md"],
  "model": "ollama/qwen-coder-local",
  "provider": {
    "ollama": {
      "models": {
        "qwen-coder-local": {
          "name": "Local Qwen2.5 Coder 7B"
        }
      }
    }
  },
  "lsp": {
    "jdtls": {
      "disabled": false,
      "roots": ["backend"]
    },
    "typescript": {
      "disabled": false,
      "roots": ["frontend"]
    },
    "eslint": {
      "disabled": false,
      "roots": ["frontend"]
    },
    "yaml-ls": {
      "disabled": false,
      "roots": [".", "backend"]
    }
  },
  "experimental": {
    "batch_tool": true
  },
  "permission": {
    "lsp": "allow",
    "bash": "ask",
    "edit": "allow"
  }
}
